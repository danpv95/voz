---
interface Props { current?: 'cambios' | 'home' }
const { current = 'home' } = Astro.props;
---
<div class="site-top">
  <div class="wrap">
    <header class="top">
      <a class="logo" href="/" aria-label="voz, inicio"><svg aria-hidden="true"><use href="#medidor"/></svg><b>voz</b></a>
      <div class="top-end">
      <nav class="nav" aria-label="Principal">
        <a class="opt" href="/#sesion">Cómo se ve</a>
        <a class="opt" href="/#privacidad">Privacidad</a>
        <a href="/cambios" aria-current={current === 'cambios' ? 'page' : undefined}>Novedades</a>
        <a href="/#instalar">Instalar</a>
      </nav>
      <!-- Oculto sin JS; public/theme-init.js lo muestra y fija etiqueta y acción. -->
      <button class="theme" type="button" hidden aria-label="Cambiar a modo oscuro" title="Cambiar a modo oscuro">
        <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"/></svg>
        <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"/></svg>
      </button>
      </div>
    </header>
  </div>
</div>
